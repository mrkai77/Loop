    "By default, Loop resumes cycles from where you last left off in each window." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "By default, Loop resumes cycles from where you last left off in each window."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig setzt Loop Zyklen dort fort, wo Sie in jedem Fenster zuletzt aufgehört haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, Loop resumes cycles from where you last left off in each window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "By default, Loop resumes cycles from where you last left off in each window."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, Loop reprend les séquences à partir de l'endroit où vous vous êtes arrêté pour la dernière fois dans chaque fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di norma, Loop riprende a ciclare da dove si era interrotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでは、Loop は各ウィンドウで最後にアクションを終了した位置から繰り返しを再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로, 각 창에서 마지막으로 남긴 지점부터 루프가 순환을 재개합니다."
          }
        },
        "nl-BE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop gaat standaard in elk venster verder met de cyclus waar je gebleven was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie Loop wznawia cykle z pozycji, w której ostatnio pozostało okno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por padrão, o \"Loop\" resume ciclos de onde você parou pela última vez em cada janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию Loop продолжает цикл с того места, на котором вы оставили окно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop默认记忆每个窗口的循环状态，并从中断处继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop默認記憶每個視窗的循環狀態，並從中斷位置繼續。"
          }
        }
      }
    },
