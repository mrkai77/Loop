    "A single %@ action can only track one window. To stash\nmultiple windows, add additional %@ actions." : {
      "comment" : "Information in a popover displaying how a stash action can only keep track of a single window. Both %1$@ and %2$@ are replaced with the language's localization of the \"Stash\" action.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A single %1$@ action can only track one window. To stash\nmultiple windows, add additional %2$@ actions."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A single %1$@ action can only track one window. To stash\nmultiple windows, add additional %2$@ actions."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A single %1$@ action can only track one window. To stash\nmultiple windows, add additional %2$@ actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A single %1$@ action can only track one window. To stash\nmultiple windows, add additional %2$@ actions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une action %1$@ ne peut suivre qu’une seule fenêtre. Pour mettre de côté\nplusieurs fenêtres, ajoutez une autre action %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una singola azione %1$@ può tracciare solamente una finestra.\nPer nascondere più finestre, aggiungi altre azioni %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は 1 つのウィンドウのみ追跡できます。複数をスタッシュ\nするには、別の%2$@アクションを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단일 %1$@ 액션은 하나의 창만 추적할 수 있습니다. 여러 창을 숨기려면 %2$@ 액션을 추가로 설정하세요."
          }
        },
        "nl-BE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een enkele %1$@-actie kan maar één venster volgen. Om meerdere vensters tijdelijk op te slaan, voeg extra %2$@-acties toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojedyncza akcja %1$@ może śledzić tylko jedno okno. Aby użyć opcji Stash na więcej niż jednym oknie, dodaj dodatkowe %2$@ akcje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma ação %1$@ pode rastrear apenas uma janela. Para ocultar múltiplas janelas, adicione ações %2$@ adicionais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действие %1$@ может следить только за одним окном. Добавьте дополнительные %2$@ действий, чтобы спрятать несколько окон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单个%1$@操作只能应用于单个窗口。要收纳多个窗口，请添加更多%2$@操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單個%1$@操作只能應用於單個視窗。要收納多個視窗，請添加更多%2$@操作。"
          }
        }
      }
    },
