    "Locked icon message 27" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثل مراحل القمر، ستكشف أيقوناتك عن نفسها في دورات التكرار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
