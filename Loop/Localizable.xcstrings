    "This will reset all keybinds to their original defaults." : {
      "comment" : "A message displayed in an alert when the user confirms resetting all keybinds.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This will reset all keybinds to their original defaults."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This will reset all keybinds to their original defaults."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will reset all keybinds to their original defaults."
          }
        },
        "es" : {
