    "Whether to allow Mission Control to open when windows\nare dragged to the top of the screen." : {
      "comment" : "A tooltip that explains the purpose of the \"Suppress Mission Control\" toggle in the Behavior Configuration view.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whether to allow Mission Control to open when windows\nare dragged to the top of the screen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt an, ob das Öffnen von Mission Control erlaubt ist, wenn Fenster\nnach oben auf dem Bildschirm gezogen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether to allow Mission Control to open when windows\nare dragged to the top of the screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whether to allow Mission Control to open when windows\nare dragged to the top of the screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser la Mission Control à s'ouvrir lorsque les fenêtres\nsont déplacées en haut de l'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica se abilitare l'apertura di Mission Control quando le finestre\nvengono trascinate nella parte superiore dello schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウ上端ドラッグ時に\nMission Control を開くかどうか。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창을 화면 상단으로 드래그할 때 Mission Control을 허용할지 여부."
          }
        },
        "nl-BE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Mission Control toe te openen wanneer vensters naar de bovenkant van het scherm worden gesleept"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whether to allow Mission Control to open when windows\nare dragged to the top of the screen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
