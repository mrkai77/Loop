        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "달의 위상처럼, 당신의 아이콘들은 루프의 주기로 자신을 드러낼 것입니다."
          }
        },
        "nl-BE" : {
          "stringUnit" : {
            "state" : "translated",
