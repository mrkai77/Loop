    "%@ could not install the update at %@ (%@). Would you like to install this update in your Applications folder instead?" : {
      "comment" : "Informative text displayed in an alert when the Loop is unable to install an update due to insufficient administrator permissions. The first argument is the name of the main app. The second argument is the path where the update failed to install. The third argument is the error.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ could not install the update at %2$@ (%3$@). Would you like to install this update in your Applications folder instead?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ could not install the update at %2$@ (%3$@). Would you like to install this update in your Applications folder instead?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ could not install the update at %2$@ (%3$@). Would you like to install this update in your Applications folder instead?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ could not install the update at %2$@ (%3$@). Would you like to install this update in your Applications folder instead?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n’a pas pu installer la mise à jour dans %2$@ (%3$@). Voulez-vous plutôt installer cette mise à jour dans votre dossier Applications ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non può installare l'aggiornamento in %2$@ (%3$@). Vuoi installare l'aggiornamento nella cartella Applicazioni invece che in quella attuale?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は %2$@（%3$@）でアップデートをインストールできませんでした。代わりにアプリケーションフォルダにインストールしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ could not install the update at %2$@ (%3$@). Would you like to install this update in your Applications folder instead?"
          }
        },
        "nl-BE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kon de update niet installeren op %2$@ (%3$@). Wil je de update in de Applicaties-folder installeren?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ could not install the update at %2$@ (%3$@). Would you like to install this update in your Applications folder instead?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não conseguiu instalar a atualização em %2$@ (%3$@). Gostaria de instalar a atualização para sua pasta Aplicativos?"
          }
        },
        "ru" : {
          "stringUnit" : {
